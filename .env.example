# Copy this file to .env and replace placeholders locally.
# Never commit .env or real credentials.

# PostgreSQL settings used by database.py
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=career_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# PostgreSQL async URL used for Agent session persistence.
# URL-encode special characters in the password.
AGENT_DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password@127.0.0.1:5432/career_agent

# Optional: Hugging Face token for higher model download rate limits.
HF_TOKEN=
