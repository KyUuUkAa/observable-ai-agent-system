# ============================================================

*.log
logs.jsonl

*.db
*.db-*
*.sqlite
*.sqlite3

archive/


# ============================================================
# Local / Private RAG Data
# ============================================================

# Personal/private RAG data must not be published.
# Keep only safe example files in Git.

data/*
!data/.gitkeep
!data/resume.example.txt


# ============================================================
# Evaluation Generated Reports
# ============================================================

reports/
evaluation/reports/


