# ============================================================

.env
.env.*
!.env.example


# ============================================================
# Python
# ============================================================

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/

.coverage
.coverage.*
coverage.xml
htmlcov/

.venv/
venv/
